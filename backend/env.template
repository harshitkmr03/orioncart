# Backend Environment Variables Template
# Copy this file to backend/.env and fill in your actual values
# DO NOT commit the .env file to version control

# Database Configuration (Supabase PostgreSQL)
DB_URL=jdbc:postgresql://your-supabase-project.supabase.co:5432/postgres
DB_USERNAME=postgres
DB_PASSWORD=your-supabase-password

# JWT Configuration
# Replace `JWT_SECRET` with a strong 32-byte base64 secret stored in your secret manager.
JWT_SECRET=REPLACE_WITH_STRONG_BASE64_SECRET
JWT_EXPIRATION_MS=86400000

# Application Configuration
SERVER_PORT=7070
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Payment Provider (if applicable)
PAYMENT_PROVIDER_API_KEY=your-payment-api-key
PAYMENT_PROVIDER_WEBHOOK_SECRET=your-webhook-secret
