# ==============================================================================
# OrionCart Backend Environment Variables Template
# Copy this file to `backend/.env` and fill in your actual values.
# NEVER commit the `.env` file to git.
# ==============================================================================

# Server & CORS
SERVER_PORT=7070
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Database Configuration (PostgreSQL / Supabase)
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/orioncart
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=your_database_password
SPRING_JPA_HIBERNATE_DDL_AUTO=none
FLYWAY_ENABLED=true

# JWT Authentication
# Must be a secure base64 string of at least 256 bits (32 bytes)
JWT_SECRET=your_32_byte_base64_secret_key_here
JWT_EXPIRATION_MS=86400000

# Google OAuth2 Authentication
GOOGLE_CLIENT_ID=your_google_web_client_id.apps.googleusercontent.com
VITE_GOOGLE_CLIENT_ID=your_google_web_client_id.apps.googleusercontent.com

# Mail & OTP Verification (Gmail SMTP)
SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=your_gmail_address@gmail.com
SPRING_MAIL_PASSWORD=your_16_character_gmail_app_password
